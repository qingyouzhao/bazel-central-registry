ALL_TOOLKITS = {
    module: list(toolkits.keys())
    for module, toolkits in TOOLKITS.items()
}

# Standard_Version.hxx is the only header the upstream build generates.
expand_template(
    name = "standard_version",
    out = "generated/Standard_Version.hxx",
    substitutions = {
        "@OCCT_VERSION_DATE@": "2025",
        "@OCC_VERSION_MAJOR@": "8",
        "@OCC_VERSION_MINOR@": "0",
        "@OCC_VERSION_MAINTENANCE@": "1",
        "@SET_OCC_VERSION_DEVELOPMENT@": "",
    },
    template = "adm/templates/Standard_Version.hxx.in",
)

occt_headers(
    name = "headers",
    generated_hdrs = [":standard_version"],
    toolkits = ALL_TOOLKITS,
    visibility = ["//visibility:public"],
)

[
    occt_library(
        name = toolkit,
        toolkits = {module: [toolkit]},
        visibility = ["//visibility:public"],
        deps = [":headers"] + [":" + dep for dep in deps],
    )
    for module, toolkits in TOOLKITS.items()
    for toolkit, deps in toolkits.items()
]

cc_library(
    name = "foundation_classes",
    visibility = ["//visibility:public"],
    deps = [":headers"] + [":" + tk for tk in ALL_TOOLKITS["FoundationClasses"]],
)

cc_library(
    name = "modeling_data",
    visibility = ["//visibility:public"],
    deps = [":headers"] + [":" + tk for tk in ALL_TOOLKITS["ModelingData"]],
)

cc_library(
    name = "modeling_algorithms",
    visibility = ["//visibility:public"],
    deps = [":headers"] + [":" + tk for tk in ALL_TOOLKITS["ModelingAlgorithms"]],
)

cc_library(
    name = "visualization",
    visibility = ["//visibility:public"],
    deps = [":headers"] + [":" + tk for tk in ALL_TOOLKITS["Visualization"]],
)

cc_library(
    name = "application_framework",
    visibility = ["//visibility:public"],
    deps = [":headers"] + [":" + tk for tk in ALL_TOOLKITS["ApplicationFramework"]],
)

cc_library(
    name = "data_exchange",
    visibility = ["//visibility:public"],
    deps = [":headers"] + [":" + tk for tk in ALL_TOOLKITS["DataExchange"]],
)

cc_library(
    name = "occt",
    visibility = ["//visibility:public"],
    deps = [
        ":application_framework",
        ":data_exchange",
        ":foundation_classes",
        ":headers",
        ":modeling_algorithms",
        ":modeling_data",
        ":visualization",
    ],
)
